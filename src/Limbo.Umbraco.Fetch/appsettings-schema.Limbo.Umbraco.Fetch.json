{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"Limbo": {
			"type": "object",
			"properties": {
				"Fetch": {
					"type": "object",
					"description": "Configuration for Limbo Umbraco Fetch.",
					"properties": {
						"Feeds": {
							"type": "array",
							"description": "A list of configured feeds.",
							"items": {
								"type": "object",
								"properties": {
									"Alias": {
										"type": "string",
										"description": "The alias of the feed."
									},
									"Url": {
										"type": "string",
										"format": "uri",
										"description": "The URL of the feed."
									},
									"Path": {
										"type": "string",
										"description": "The path of the feed."
									},
									"AbsolutePath": {
										"type": "string",
										"description": "The absolute path of the feed."
									},
									"Interval": {
										"type": [
											"string",
											"integer"
										],
										"description": "The interval between downloads. A numeric value specifies the number of minutes. A string may be a .NET TimeSpan value (e.g. \"00:15:00\") or an ISO 8601 duration (e.g. \"PT15M\").",
										"examples": [
											15,
											"00:15:00",
											"PT15M"
										]
									}
								},
								"required": [
									"Alias",
									"Url"
								],
								"additionalProperties": false
							}
						},
						"Scheduling": {
							"type": "object",
							"description": "Configuration for automatic feed scheduling.",
							"properties": {
								"Enabled": {
									"type": "boolean",
									"description": "Whether automatic scheduling is enabled.",
									"default": true
								},
								"Delay": {
									"type": [
										"string",
										"integer"
									],
									"description": "The initial delay before scheduling starts. A numeric value specifies the number of minutes. A string may be a .NET TimeSpan value (e.g. \"00:01:00\") or an ISO 8601 duration (e.g. \"PT1M\").",
									"default": "00:01:00",
									"examples": [
										1,
										"00:01:00",
										"PT1M"
									]
								},
								"Interval": {
									"type": [
										"string",
										"integer"
									],
									"description": "The interval between scheduled runs. A numeric value specifies the number of minutes. A string may be a .NET TimeSpan value (e.g. \"01:00:00\") or an ISO 8601 duration (e.g. \"PT1H\").",
									"default": "01:00:00",
									"examples": [
										60,
										"01:00:00",
										"PT1H"
									]
								}
							},
							"additionalProperties": false
						}
					},
					"additionalProperties": false
				}
			}
		}
	}
}