{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"Limbo": {
			"type": "object",
			"properties": {
				"Fetch": {
					"type": "object",
					"description": "Configuration for Limbo Umbraco Fetch.",
					"properties": {
						"Feeds": {
							"type": "array",
							"description": "A list of configured feeds.",
							"items": {
								"type": "object",
								"properties": {
									"Alias": {
										"type": "string",
										"description": "The alias of the feed."
									},
									"Url": {
										"type": "string",
										"format": "uri",
										"description": "The URL of the feed."
									},
									"Path": {
										"type": "string",
										"description": "The path of the feed."
									},
									"AbsolutePath": {
										"type": "string",
										"description": "The absolute path of the feed."
									},
									"Interval": {
										"type": [
											"string",
											"integer"
										],
										"description": "The interval between downloads. An integer is interpreted as a number of minutes. A string may be a .NET TimeSpan value or an XML duration such as PT15M."
									}
								},
								"required": [
									"Alias",
									"Url",
									"Path",
									"Interval"
								],
								"additionalProperties": false
							}
						}
					},
					"additionalProperties": false
				}
			}
		}
	}
}